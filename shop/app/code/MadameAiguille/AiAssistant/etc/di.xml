<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <preference for="MadameAiguille\AiAssistant\Model\Claude\ClientInterface" type="MadameAiguille\AiAssistant\Model\Claude\ClientRouter"/>

    <!-- Journal de consommation dédié, sans contenu (UsageLogger) -->
    <virtualType name="MadameAiguille\AiAssistant\Logger\Handler" type="Magento\Framework\Logger\Handler\Base">
        <arguments>
            <argument name="fileName" xsi:type="string">/var/log/madameaiguille_assistant_ia.log</argument>
        </arguments>
    </virtualType>
    <virtualType name="MadameAiguille\AiAssistant\Logger" type="Magento\Framework\Logger\Monolog">
        <arguments>
            <argument name="name" xsi:type="string">assistant_ia</argument>
            <argument name="handlers" xsi:type="array">
                <item name="file" xsi:type="object">MadameAiguille\AiAssistant\Logger\Handler</item>
            </argument>
        </arguments>
    </virtualType>
    <type name="MadameAiguille\AiAssistant\Model\UsageLogger">
        <arguments>
            <argument name="logger" xsi:type="object">MadameAiguille\AiAssistant\Logger</argument>
        </arguments>
    </type>
</config>

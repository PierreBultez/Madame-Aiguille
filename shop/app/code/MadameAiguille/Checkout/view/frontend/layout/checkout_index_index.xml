<?xml version="1.0"?>
<!--
/**
 * Sélection du point relais et rendez-vous de retrait, sous la liste des modes de livraison (région native shippingAdditional).
 * Composant fonctionnel du module ; son habillage relève du thème Luma enfant (lot 6b).
 */
-->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <css src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" src_type="url"/>
    </head>
    <body>
        <referenceBlock name="checkout.root">
            <arguments>
                <argument name="jsLayout" xsi:type="array">
                    <item name="components" xsi:type="array">
                        <item name="checkout" xsi:type="array">
                            <item name="children" xsi:type="array">
                                <item name="steps" xsi:type="array">
                                    <item name="children" xsi:type="array">
                                        <item name="shipping-step" xsi:type="array">
                                            <item name="children" xsi:type="array">
                                                <item name="shippingAddress" xsi:type="array">
                                                    <item name="children" xsi:type="array">
                                                        <item name="shippingAdditional" xsi:type="array">
                                                            <item name="component" xsi:type="string">uiComponent</item>
                                                            <item name="displayArea" xsi:type="string">shippingAdditional</item>
                                                            <item name="children" xsi:type="array">
                                                                <item name="madameaiguille-relay-point" xsi:type="array">
                                                                    <item name="component" xsi:type="string">MadameAiguille_Checkout/js/view/relay-point</item>
                                                                    <item name="sortOrder" xsi:type="string">10</item>
                                                                </item>
                                                                <item name="madameaiguille-pickup-slot" xsi:type="array">
                                                                    <item name="component" xsi:type="string">MadameAiguille_Checkout/js/view/pickup-slot</item>
                                                                    <item name="sortOrder" xsi:type="string">20</item>
                                                                </item>
                                                            </item>
                                                        </item>
                                                    </item>
                                                </item>
                                            </item>
                                        </item>
                                    </item>
                                </item>
                            </item>
                        </item>
                    </item>
                </argument>
            </arguments>
        </referenceBlock>
    </body>
</page>

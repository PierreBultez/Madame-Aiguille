<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <madameaiguille>
            <!-- Code de démonstration Mondial Relay ; le code enseigne du compte pro est saisi en configuration, jamais versionné -->
            <mondial_relay>
                <brand_code>BDTEST</brand_code>
            </mondial_relay>
            <!-- Lieu générique en attendant l'adresse de Céline ; plages du call du 11/09/2026 (jeudi 9 h-18 h, vendredi 9 h-11 h 30) -->
            <pickup>
                <location_name>Atelier Madame Aiguille</location_name>
                <location_address>Saint-Épain (37800)
L'adresse exacte vous est rappelée dans l'e-mail de confirmation.</location_address>
                <latitude>47.1450</latitude>
                <longitude>0.5370</longitude>
                <weekly_hours>{"thursday":{"day":"4","from":"09:00","to":"18:00"},"friday":{"day":"5","from":"09:00","to":"11:30"}}</weekly_hours>
                <slot_duration>30</slot_duration>
                <capacity>1</capacity>
                <min_notice_hours>48</min_notice_hours>
                <horizon_days>21</horizon_days>
                <closed_dates/>
            </pickup>
            <!-- Décision de Pierre du 09/10/2026 : option payante à 2 €, prix réglable -->
            <gift_wrap>
                <enabled>1</enabled>
                <price>2.00</price>
                <label>Emballage cadeau</label>
                <description>Votre commande est emballée avec soin pour être offerte. Ajoutez un message cadeau : je l'écris à la main sur une petite carte.</description>
            </gift_wrap>
        </madameaiguille>
        <carriers>
            <madameaiguille_pickup>
                <active>1</active>
                <model>MadameAiguille\Checkout\Model\Carrier\Pickup</model>
                <title>Retrait à l'atelier</title>
                <name>Sur rendez-vous, en ligne ou sur place</name>
                <sallowspecific>1</sallowspecific>
                <specificcountry>FR</specificcountry>
                <showmethod>0</showmethod>
                <sort_order>20</sort_order>
                <specificerrmsg>Le retrait à l'atelier n'est pas proposé pour cette adresse.</specificerrmsg>
            </madameaiguille_pickup>
        </carriers>
        <!--
            Stripe (lot 8) : formulaire de paiement intégré au tunnel, encaissement immédiat. Carte, Apple Pay et
            Google Pay se choisissent dans le tableau de bord Stripe. Les boutons express et les messages de paiement
            fractionné restent coupés : ils contourneraient le choix du point relais et du créneau, et leur JavaScript
            Luma ne tourne pas sur les pages Hyvä. Clés et mode se saisissent dans l'administration.
        -->
        <payment>
            <stripe_payments>
                <title>Carte bancaire en ligne</title>
                <payment_action>authorize_capture</payment_action>
                <payment_flow>0</payment_flow>
                <adaptive_pricing>0</adaptive_pricing>
                <save_payment_method>0</save_payment_method>
                <receipt_emails>0</receipt_emails>
            </stripe_payments>
            <stripe_payments_express>
                <global_enabled>0</global_enabled>
                <enabled/>
            </stripe_payments_express>
            <stripe_payments_payment_method_messaging>
                <show_on_product_page>0</show_on_product_page>
                <show_in_minicart>0</show_in_minicart>
                <show_in_shopping_cart>0</show_in_shopping_cart>
            </stripe_payments_payment_method_messaging>
            <stripe_payments_subscriptions>
                <active>0</active>
            </stripe_payments_subscriptions>
            <stripe_payments_bank_transfers>
                <active>0</active>
            </stripe_payments_bank_transfers>
        </payment>
    </default>
</config>

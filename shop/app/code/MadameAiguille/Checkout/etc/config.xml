<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <madameaiguille>
            <!-- Code de démonstration Mondial Relay, à remplacer par le code enseigne de l'Offre Start de Céline -->
            <mondial_relay>
                <brand_code>BDTEST</brand_code>
            </mondial_relay>
            <!-- Lieu générique en attendant l'adresse de Céline ; plages du call du 11/09/2026 (jeudi 9 h-18 h, vendredi 9 h-11 h 30) -->
            <pickup>
                <location_name>Atelier Madame Aiguille</location_name>
                <location_address>Saint-Épain (37800)
L'adresse exacte vous est rappelée dans l'e-mail de confirmation.</location_address>
                <latitude>47.1450</latitude>
                <longitude>0.5370</longitude>
                <weekly_hours>{"thursday":{"day":"4","from":"09:00","to":"18:00"},"friday":{"day":"5","from":"09:00","to":"11:30"}}</weekly_hours>
                <slot_duration>30</slot_duration>
                <capacity>1</capacity>
                <min_notice_hours>48</min_notice_hours>
                <horizon_days>21</horizon_days>
                <closed_dates/>
            </pickup>
            <!-- Décision de Pierre du 09/10/2026 : option payante à 2 €, prix réglable -->
            <gift_wrap>
                <enabled>1</enabled>
                <price>2.00</price>
                <label>Emballage cadeau</label>
                <description>Votre commande est emballée avec soin pour être offerte. Ajoutez un message cadeau : je l'écris à la main sur une petite carte.</description>
            </gift_wrap>
        </madameaiguille>
        <carriers>
            <madameaiguille_pickup>
                <active>1</active>
                <model>MadameAiguille\Checkout\Model\Carrier\Pickup</model>
                <title>Retrait à l'atelier</title>
                <name>Sur rendez-vous, payé sur place</name>
                <sallowspecific>1</sallowspecific>
                <specificcountry>FR</specificcountry>
                <showmethod>0</showmethod>
                <sort_order>20</sort_order>
                <specificerrmsg>Le retrait à l'atelier n'est pas proposé pour cette adresse.</specificerrmsg>
            </madameaiguille_pickup>
        </carriers>
    </default>
</config>

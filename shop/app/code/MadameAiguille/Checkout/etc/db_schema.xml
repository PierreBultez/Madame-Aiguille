<?xml version="1.0"?>
<!--
/**
 * Choix de livraison du tunnel, portés par l'adresse de livraison du panier puis de la commande :
 * point relais Mondial Relay (ex. « FR-087807 », et ses coordonnées tant que la commande n'est pas passée)
 * ou créneau de retrait (« AAAA-MM-JJ HH:MM », heure de la boutique).
 * Les places réservées sur les créneaux vivent dans leur propre table.
 * Emballage cadeau : choix sur le panier, montant sur l'adresse du panier, la commande, la facture et l'avoir.
 */
-->
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="quote">
        <column xsi:type="smallint" name="madameaiguille_gift_wrap" unsigned="true" nullable="false" default="0" comment="Gift wrapping requested"/>
    </table>
    <table name="quote_address">
        <column xsi:type="decimal" name="madameaiguille_gift_wrap_amount" scale="4" precision="20" unsigned="false" nullable="true" comment="Gift wrapping amount"/>
        <column xsi:type="decimal" name="base_madameaiguille_gift_wrap_amount" scale="4" precision="20" unsigned="false" nullable="true" comment="Base gift wrapping amount"/>
        <column xsi:type="varchar" name="madameaiguille_relay_point_id" nullable="true" length="16" comment="Mondial Relay point ID"/>
        <column xsi:type="text" name="madameaiguille_relay_point" nullable="true" comment="Mondial Relay point details, JSON"/>
        <column xsi:type="varchar" name="madameaiguille_pickup_slot" nullable="true" length="16" comment="Pickup slot, store local time"/>
    </table>
    <table name="sales_order_address">
        <column xsi:type="varchar" name="madameaiguille_relay_point_id" nullable="true" length="16" comment="Mondial Relay point ID"/>
        <column xsi:type="varchar" name="madameaiguille_pickup_slot" nullable="true" length="16" comment="Pickup slot, store local time"/>
    </table>
    <table name="sales_order">
        <column xsi:type="decimal" name="madameaiguille_gift_wrap_amount" scale="4" precision="20" unsigned="false" nullable="true" comment="Gift wrapping amount"/>
        <column xsi:type="decimal" name="base_madameaiguille_gift_wrap_amount" scale="4" precision="20" unsigned="false" nullable="true" comment="Base gift wrapping amount"/>
    </table>
    <table name="sales_invoice">
        <column xsi:type="decimal" name="madameaiguille_gift_wrap_amount" scale="4" precision="20" unsigned="false" nullable="true" comment="Gift wrapping amount"/>
        <column xsi:type="decimal" name="base_madameaiguille_gift_wrap_amount" scale="4" precision="20" unsigned="false" nullable="true" comment="Base gift wrapping amount"/>
    </table>
    <table name="sales_creditmemo">
        <column xsi:type="decimal" name="madameaiguille_gift_wrap_amount" scale="4" precision="20" unsigned="false" nullable="true" comment="Gift wrapping amount"/>
        <column xsi:type="decimal" name="base_madameaiguille_gift_wrap_amount" scale="4" precision="20" unsigned="false" nullable="true" comment="Base gift wrapping amount"/>
    </table>
    <table name="madameaiguille_pickup_booking" resource="default" engine="innodb" comment="Pickup slot bookings, one row per seat">
        <column xsi:type="int" name="booking_id" unsigned="true" nullable="false" identity="true" comment="Booking ID"/>
        <column xsi:type="varchar" name="slot" nullable="false" length="16" comment="Pickup slot, store local time"/>
        <column xsi:type="smallint" name="seat" unsigned="true" nullable="false" default="1" comment="Seat number within the slot"/>
        <column xsi:type="int" name="quote_id" unsigned="true" nullable="false" comment="Quote ID"/>
        <column xsi:type="int" name="order_id" unsigned="true" nullable="true" comment="Order ID once placed"/>
        <column xsi:type="timestamp" name="created_at" on_update="false" nullable="false" default="CURRENT_TIMESTAMP" comment="Created at"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="booking_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="MADAMEAIGUILLE_PICKUP_BOOKING_SLOT_SEAT">
            <column name="slot"/>
            <column name="seat"/>
        </constraint>
        <index referenceId="MADAMEAIGUILLE_PICKUP_BOOKING_QUOTE_ID" indexType="btree">
            <column name="quote_id"/>
        </index>
        <index referenceId="MADAMEAIGUILLE_PICKUP_BOOKING_ORDER_ID" indexType="btree">
            <column name="order_id"/>
        </index>
    </table>
</schema>

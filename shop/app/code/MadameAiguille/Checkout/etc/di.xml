<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\Quote\Model\Quote\Payment">
        <plugin name="madameaiguille_newsletter_consent"
                type="MadameAiguille\Checkout\Plugin\Checkout\CaptureNewsletterConsent"/>
    </type>
    <preference for="MadameAiguille\Checkout\Api\Data\RelayPointInterface" type="MadameAiguille\Checkout\Model\RelayPoint"/>
    <preference for="MadameAiguille\Checkout\Api\PickupSlotsInterface" type="MadameAiguille\Checkout\Model\Pickup\PickupSlots"/>

    <!-- Point relais et créneau de retrait : contrôlés au passage de l'étape Livraison, pour le tunnel comme pour l'API -->
    <type name="Magento\Checkout\Api\ShippingInformationManagementInterface">
        <plugin name="madameaiguille_assign_relay_point" type="MadameAiguille\Checkout\Plugin\Checkout\AssignRelayPoint" sortOrder="10"/>
        <plugin name="madameaiguille_assign_pickup_slot" type="MadameAiguille\Checkout\Plugin\Checkout\AssignPickupSlot" sortOrder="20"/>
        <plugin name="madameaiguille_assign_gift_wrap" type="MadameAiguille\Checkout\Plugin\Checkout\AssignGiftWrap" sortOrder="30"/>
    </type>

    <!-- Connexion depuis le tunnel sans CAPTCHA : identifiant de formulaire absent toléré en PHP 8.5 -->
    <type name="Magento\Captcha\Helper\Data">
        <plugin name="madameaiguille_tolerate_missing_captcha_form_id" type="MadameAiguille\Checkout\Plugin\Customer\TolerateMissingCaptchaFormId"/>
    </type>

    <!-- Emails de facture, d'avoir et d'expédition : encart « Emballage et message cadeau » sous les articles -->
    <type name="Magento\Sales\Block\Order\Email\Invoice\Items">
        <plugin name="madameaiguille_append_gift_card" type="MadameAiguille\Checkout\Plugin\Sales\AppendGiftCardToEmail"/>
    </type>
    <type name="Magento\Sales\Block\Order\Email\Creditmemo\Items">
        <plugin name="madameaiguille_append_gift_card" type="MadameAiguille\Checkout\Plugin\Sales\AppendGiftCardToEmail"/>
    </type>
    <type name="Magento\Sales\Block\Order\Email\Shipment\Items">
        <plugin name="madameaiguille_append_gift_card" type="MadameAiguille\Checkout\Plugin\Sales\AppendGiftCardToEmail"/>
    </type>

    <!-- PDF de facture, d'avoir et de bon de livraison : « Emballage et message cadeau » avant les articles -->
    <type name="Magento\Sales\Model\Order\Pdf\Invoice">
        <plugin name="madameaiguille_gift_card_on_pdf" type="MadameAiguille\Checkout\Plugin\Sales\GiftCardOnPdf"/>
    </type>
    <type name="Magento\Sales\Model\Order\Pdf\Creditmemo">
        <plugin name="madameaiguille_gift_card_on_pdf" type="MadameAiguille\Checkout\Plugin\Sales\GiftCardOnPdf"/>
    </type>
    <type name="Magento\Sales\Model\Order\Pdf\Shipment">
        <plugin name="madameaiguille_gift_card_on_pdf" type="MadameAiguille\Checkout\Plugin\Sales\GiftCardOnPdf"/>
    </type>

    <!-- Point relais et créneau de retrait : du panier à la commande -->
    <type name="Magento\Quote\Model\Quote\Address\ToOrderAddress">
        <plugin name="madameaiguille_copy_delivery_choices_to_order" type="MadameAiguille\Checkout\Plugin\Sales\CopyDeliveryChoicesToOrder" sortOrder="10"/>
    </type>

    <!-- Grille Mondial Relay : poids de l'emballage type ajouté au colis, le temps du calcul -->
    <type name="Magento\OfflineShipping\Model\Carrier\Tablerate">
        <plugin name="madameaiguille_add_packaging_weight" type="MadameAiguille\Checkout\Plugin\Shipping\AddPackagingWeight" sortOrder="10"/>
    </type>

    <!-- Expédition : « Expédiée » ou « Livrée » (retrait) au lieu du statut natif « complete » -->
    <type name="Magento\Sales\Model\ResourceModel\Order\Handler\State">
        <plugin name="madameaiguille_status_on_completion" type="MadameAiguille\Checkout\Plugin\Sales\StatusOnCompletion" sortOrder="10"/>
    </type>

    <!-- Email « Prête pour retrait » du lot 7 : rendez-vous, lieu et itinéraire -->
    <type name="MadameAiguille\Theme\Model\Order\Email\StatusEmailSender">
        <arguments>
            <argument name="variableProviders" xsi:type="array">
                <item name="madameaiguille_pickup" xsi:type="object">MadameAiguille\Checkout\Model\Pickup\EmailVariables</item>
            </argument>
        </arguments>
    </type>
</config>

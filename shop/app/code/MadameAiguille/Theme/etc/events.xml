<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <event name="catalog_product_save_commit_after">
        <observer name="madameaiguille_refresh_home_products" instance="MadameAiguille\Theme\Observer\RefreshHomeProducts"/>
    </event>
    <event name="sales_order_save_after">
        <observer name="madameaiguille_send_order_status_email"
                  instance="MadameAiguille\Theme\Observer\SendOrderStatusEmail"/>
    </event>
</config>

<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <newsletter>
            <general><active>1</active></general>
            <subscription><confirm>1</confirm><allow_guest_subscribe>1</allow_guest_subscribe></subscription>
        </newsletter>
        <madameaiguille>
            <social>
                <instagram_url/>
                <facebook_url/>
                <pinterest_url/>
            </social>
            <catalog>
                <scarcity_threshold>3</scarcity_threshold>
                <price_note/>
            </catalog>
            <!-- Décision de Pierre du 10/09/2026 : franco affiché dès la v1 au seuil des maquettes ; code promo masqué -->
            <cart>
                <free_shipping_threshold>49</free_shipping_threshold>
                <show_coupon>0</show_coupon>
            </cart>
        </madameaiguille>
        <!-- Décision du 05/09/2026 : les produits épuisés restent visibles (badge « Épuisé », fin de liste) -->
        <!-- Poids saisis en kilogrammes (grilles transporteurs françaises) -->
        <general>
            <locale>
                <weight_unit>kgs</weight_unit>
            </locale>
        </general>
        <!-- Liste produits : grille seule, 24 par page (les épuisés sont regroupés par page), tri par nouveauté -->
        <catalog>
            <frontend>
                <list_mode>grid</list_mode>
                <grid_per_page_values>24</grid_per_page_values>
                <grid_per_page>24</grid_per_page>
                <default_sort_by>created_at</default_sort_by>
            </frontend>
        </catalog>
        <cataloginventory>
            <options>
                <show_out_of_stock>1</show_out_of_stock>
            </options>
        </cataloginventory>
    </default>
</config>

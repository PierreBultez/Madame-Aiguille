<?xml version="1.0"?>
<!--
/**
 * Madame Aiguille — fraîcheur des badges de stock : purge des caches produit
 * à chaque mouvement de quantité (réservation MSI, enregistrement de source).
 */
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\InventorySalesApi\Api\PlaceReservationsForSalesEventInterface">
        <plugin name="madameaiguille_flush_cache_after_reservations" type="MadameAiguille\Theme\Plugin\Inventory\FlushCacheAfterReservations" sortOrder="100"/>
    </type>
    <type name="Magento\InventoryApi\Api\SourceItemsSaveInterface">
        <plugin name="madameaiguille_flush_cache_after_source_items_save" type="MadameAiguille\Theme\Plugin\Inventory\FlushCacheAfterSourceItemsSave" sortOrder="100"/>
    </type>

    <!-- Mini-panier : plafond de stock par ligne et état du franco de port (lot 4) -->
    <type name="Magento\Checkout\CustomerData\Cart">
        <plugin name="madameaiguille_add_cart_data" type="MadameAiguille\Theme\Plugin\Checkout\CustomerData\AddCartData" sortOrder="100"/>
    </type>

    <!-- Lot 5 : mention de TVA lisible par {{config}} dans les e-mails, et imprimée sur les factures PDF -->
    <type name="Magento\Variable\Model\Config\Structure\AvailableVariables">
        <arguments>
            <argument name="configPaths" xsi:type="array">
                <item name="madameaiguille/legal" xsi:type="array">
                    <item name="madameaiguille/legal/vat_mention" xsi:type="string">1</item>
                </item>
            </argument>
        </arguments>
    </type>
    <type name="Magento\Sales\Model\Order\Pdf\Invoice">
        <plugin name="madameaiguille_vat_mention_on_invoice_pdf" type="MadameAiguille\Theme\Plugin\Sales\VatMentionOnInvoicePdf" sortOrder="100"/>
    </type>

    <!-- Lot 5 : franco de port sur le point relais, au seuil affiché dans le panier -->
    <type name="Magento\OfflineShipping\Model\Carrier\Tablerate">
        <plugin name="madameaiguille_free_relay_above_threshold" type="MadameAiguille\Theme\Plugin\Shipping\FreeRelayAboveThreshold" sortOrder="100"/>
    </type>

    <!-- Lot 8a : proxy, car toutes les commandes sont construites à chaque bin/magento, setup:install compris -->
    <type name="MadameAiguille\Theme\Console\Command\CheckEnvironment">
        <arguments>
            <argument name="checker" xsi:type="object">MadameAiguille\Theme\Model\Environment\EnvironmentChecker\Proxy</argument>
        </arguments>
    </type>

    <!-- Lot 5 : grille de frais de port rejouable, contrôle des poids avant mise en production -->
    <type name="Magento\Framework\Console\CommandList">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="madameaiguille_catalog_check_weight" xsi:type="object">MadameAiguille\Theme\Console\Command\CheckWeight</item>
                <item name="madameaiguille_shipping_import_rates" xsi:type="object">MadameAiguille\Theme\Console\Command\ImportTableRates</item>
                <!-- Lot 8a : contrôle de l'environnement après chaque déploiement -->
                <item name="madameaiguille_env_check" xsi:type="object">MadameAiguille\Theme\Console\Command\CheckEnvironment</item>
            </argument>
        </arguments>
    </type>
</config>

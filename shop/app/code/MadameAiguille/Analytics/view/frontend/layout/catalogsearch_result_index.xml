<?xml version="1.0"?>
<!-- Recherche interne : mot-clé et nombre de résultats (trackSiteSearch à la place de trackPageView) -->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="madameaiguille.analytics.tracker">
            <arguments>
                <argument name="page_type" xsi:type="const">MadameAiguille\Analytics\ViewModel\Tracker::PAGE_SEARCH</argument>
            </arguments>
        </referenceBlock>
    </body>
</page>

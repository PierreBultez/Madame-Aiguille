<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Acl/etc/acl.xsd">
    <acl>
        <resources>
            <resource id="Magento_Backend::admin">
                <!-- Lien « Statistiques du site » : à cocher, avec « Rapports », dans le rôle « Atelier » de Céline -->
                <resource id="Magento_Reports::report">
                    <resource id="MadameAiguille_Analytics::statistics" title="Statistiques du site (Matomo)" sortOrder="5"/>
                </resource>
                <resource id="Magento_Backend::stores">
                    <resource id="Magento_Backend::stores_settings">
                        <resource id="Magento_Config::config">
                            <resource id="MadameAiguille_Analytics::config" title="Mesure d'audience" sortOrder="155"/>
                        </resource>
                    </resource>
                </resource>
            </resource>
        </resources>
    </acl>
</config>

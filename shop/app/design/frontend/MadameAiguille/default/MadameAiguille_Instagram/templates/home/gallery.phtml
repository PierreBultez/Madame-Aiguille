<?php
/**
 * Madame Aiguille — « Instants d'atelier » : publications Instagram synchronisées par le serveur (lot 11, C1).
 * Images servies par le site, liens vers Instagram ouverts dans un nouvel onglet. Sans publication, le bloc CMS
 * `home_instagram` (enfant `fallback`) s'affiche comme avant.
 */

declare(strict_types=1);

use MadameAiguille\Instagram\ViewModel\Gallery;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;

/** @var Template $block */
/** @var Escaper $escaper */
/** @var Gallery $gallery */
$gallery = $block->getData('gallery_view_model');
$items = $gallery->getItems();
?>
<?php if ($items === []): ?>
    <?= $block->getChildHtml('fallback') ?>
<?php else: ?>
    <?php $intro = $gallery->getIntro() ?>
    <?php if ($intro !== ''): ?>
        <p class="home-intro"><?= $escaper->escapeHtml($intro) ?></p>
    <?php endif ?>
    <ul class="home-gallery home-gallery--instagram">
        <?php foreach ($items as $item): ?>
            <li>
                <a href="<?= $escaper->escapeUrl($item['permalink']) ?>" target="_blank" rel="noopener noreferrer">
                    <img src="<?= $escaper->escapeUrl($item['src']) ?>"
                         alt="<?= $escaper->escapeHtmlAttr($item['alt']) ?>"
                         width="<?= (int) $item['width'] ?>" height="<?= (int) $item['height'] ?>" loading="lazy">
                    <span class="sr-only"><?= $escaper->escapeHtml(__('(nouvelle fenêtre)')) ?></span>
                </a>
            </li>
        <?php endforeach ?>
    </ul>
<?php endif ?>

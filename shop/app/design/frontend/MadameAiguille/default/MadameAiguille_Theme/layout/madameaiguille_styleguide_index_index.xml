<?xml version="1.0"?>
<!--
/**
 * Madame Aiguille — page de contrôle du socle graphique (/styleguide)
 */
-->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" layout="1column" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <title>Page de contrôle — Madame Aiguille</title>
        <meta name="robots" content="NOINDEX,NOFOLLOW"/>
    </head>
    <body>
        <attribute name="class" value="page-styleguide"/>
        <referenceBlock name="page.main.title" remove="true"/>
        <referenceBlock name="breadcrumbs" remove="true"/>
        <referenceContainer name="content">
            <block name="madameaiguille.styleguide" template="MadameAiguille_Theme::styleguide.phtml"/>
        </referenceContainer>
    </body>
</page>

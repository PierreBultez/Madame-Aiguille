<?xml version="1.0"?>
<!--
/**
 * Madame Aiguille — page de contrôle du socle graphique (/styleguide)
 */
-->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" layout="1column" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <title>Page de contrôle — Madame Aiguille</title>
        <meta name="robots" content="NOINDEX,NOFOLLOW"/>
    </head>
    <body>
        <attribute name="class" value="page-styleguide"/>
        <referenceBlock name="page.main.title" remove="true"/>
        <referenceBlock name="breadcrumbs" remove="true"/>
        <referenceContainer name="content">
            <block name="madameaiguille.styleguide" template="MadameAiguille_Theme::styleguide.phtml">
                <arguments>
                    <!-- La barre de franco du styleguide est calculée par le vrai ViewModel : aucune règle n'est réécrite ici. -->
                    <argument name="free_shipping" xsi:type="object">MadameAiguille\Theme\ViewModel\Cart\FreeShipping</argument>
                    <!-- Les états de commande sont produits par le vrai ViewModel Order\Progress sur des commandes d'exemple non enregistrées. -->
                    <argument name="order_states" xsi:type="object">MadameAiguille\Theme\ViewModel\Styleguide\OrderStates</argument>
                    <argument name="confirmation_examples" xsi:type="object">MadameAiguille\Checkout\ViewModel\ConfirmationExamples</argument>
                </arguments>
                <block name="styleguide.confirmation.delivery" template="Magento_Checkout::confirmation/delivery.phtml"/>
            </block>
        </referenceContainer>
    </body>
</page>

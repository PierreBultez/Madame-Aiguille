<?php
declare(strict_types=1);

use MadameAiguille\Theme\ViewModel\Home\Products;
use Hyva\Theme\ViewModel\ProductListItem;
use Magento\Catalog\Block\Product\ReviewRendererInterface;
use Magento\Framework\View\Element\Template;

/** @var Template $block */
/** @var Products $products */
/** @var ProductListItem $renderer */
$products = $block->getData('products_view_model');
$renderer = $block->getData('item_renderer');
$limit = max(1, (int) ($block->getData('products_count') ?: 4));
$items = $products->getItems(
    $block->getProductCollection(),
    $limit,
    $block->getData('required_attribute') ?: null
);
if (!$items) {
    return;
}
?>
<?= $block->getChildHtml('heading') ?>
<div class="home-products">
    <?php foreach ($items as $product): ?>
        <?= $renderer->getItemHtmlWithRenderer(
            $block->getLayout()->getBlock('product_list_item'),
            $product,
            $block,
            'grid',
            ReviewRendererInterface::SHORT_VIEW,
            'category_page_grid',
            false
        ) ?>
    <?php endforeach; ?>
</div>

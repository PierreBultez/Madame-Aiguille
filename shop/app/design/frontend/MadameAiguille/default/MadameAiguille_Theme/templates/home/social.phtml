<?php
declare(strict_types=1);

use MadameAiguille\Theme\ViewModel\SocialLinks;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;

/** @var Template $block */
/** @var Escaper $escaper */
/** @var SocialLinks $socialLinks */
$socialLinks = $block->getData('social_links');
?>
<?php foreach ($socialLinks->getLinks() as $link): ?>
    <?php if ($link['icon'] === 'instagram'): ?>
        <p class="text-center mt-6"><a class="btn btn-secondary" href="<?= $escaper->escapeUrl($link['url']) ?>" target="_blank" rel="noopener noreferrer"><?= $escaper->escapeHtml(__('Suivez-nous sur Instagram')) ?><span class="sr-only"> <?= $escaper->escapeHtml(__('(nouvelle fenêtre)')) ?></span></a></p>
    <?php endif; ?>
<?php endforeach; ?>

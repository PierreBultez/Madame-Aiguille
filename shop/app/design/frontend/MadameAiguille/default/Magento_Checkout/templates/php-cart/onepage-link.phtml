<?php
/**
 * Madame Aiguille — accès au tunnel de commande depuis le panier
 *
 * Le lien natif est conservé, y compris son ouverture de la fenêtre
 * d'authentification (`toggle-authentication`) qui laisse le choix entre
 * commande invité et connexion. Seuls le libellé et le gabarit changent.
 */

declare(strict_types=1);

use Magento\Checkout\Block\Onepage\Link;
use Magento\Framework\Escaper;

/** @var Escaper $escaper */
/** @var Link $block */
?>
<?php if ($block->isPossibleOnepageCheckout()): ?>
    <a
        id="checkout-link-button"
        href="<?= $escaper->escapeUrl($block->getCheckoutUrl()) ?>"
        @click.prevent.stop="$dispatch('toggle-authentication', {url: '<?= $escaper->escapeJs($escaper->escapeUrl($block->getCheckoutUrl())) ?>'});"
        class="btn btn-primary btn-size-lg btn-checkout w-full"
    >
        <?= $escaper->escapeHtml(__('Passer commande')) ?>
    </a>
<?php endif ?>

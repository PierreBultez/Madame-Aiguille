<?php
declare(strict_types=1);

use Magento\Checkout\Block\Cart;
use Magento\Framework\Escaper;

/** @var Cart $block */
/** @var Escaper $escaper */

$preview = (bool) $block->getData('preview');
$headingTag = $preview ? 'h3' : 'h1';
?>
<div class="cart-empty-page">
    <?= $block->getChildHtml('checkout_cart_empty_widget') ?>
    <section class="empty-state cart-empty-state" role="status">
        <svg width="58" height="58" viewBox="0 0 40 40" fill="none" stroke="currentColor"
             stroke-width="1.2" stroke-linecap="round" aria-hidden="true">
            <path d="M10 14h20l-1.6 18H11.6L10 14Z"/>
            <path d="M15.5 14v-2.5a4.5 4.5 0 0 1 9 0V14"/>
            <path d="M15 22.5h10" stroke-dasharray="2.5 3.5"/>
        </svg>
        <<?= /* @noEscape */ $headingTag ?>><?= $escaper->escapeHtml(__('Votre panier est vide')) ?></<?= /* @noEscape */ $headingTag ?>>
        <p><?= $escaper->escapeHtml(__('Les séries tournent vite : il y a sans doute quelque chose de neuf depuis votre dernière visite.')) ?></p>
        <a href="<?= $escaper->escapeUrl($preview ? '#' : $block->getContinueShoppingUrl()) ?>" class="btn btn-primary">
            <?= $escaper->escapeHtml(__('Découvrir la boutique')) ?>
        </a>
    </section>

    <?php if (!$preview): ?>
        <section class="cart-empty-recommendations" aria-label="<?= $escaper->escapeHtmlAttr(__('Nouveautés')) ?>">
            <?= $block->getChildHtml('recommendations') ?>
        </section>
    <?php endif; ?>
    <?= $block->getChildHtml('shopping.cart.table.after') ?>
</div>

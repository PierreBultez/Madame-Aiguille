<?php
/**
 * Formulaire natif Hyvä de réinitialisation, avec actions accessibles.
 */

declare(strict_types=1);

use Hyva\Theme\Model\ViewModelRegistry;
use Hyva\Theme\ViewModel\HeroiconsSolid;
use Hyva\Theme\ViewModel\HyvaCsp;
use Magento\Customer\Block\Account\Resetpassword;
use Magento\Framework\Escaper;

/** @var Resetpassword $block */
/** @var Escaper $escaper */
/** @var ViewModelRegistry $viewModels */
/** @var HyvaCsp $hyvaCsp */
$heroicons = $viewModels->require(HeroiconsSolid::class);
$minimumPasswordLength = $block->getMinimumPasswordLength();
$passwordMinCharacterSets = $block->getRequiredCharacterClassesNumber();
?>
<div class="mb-12">
    <div class="w-full card my-8">
        <form action="<?= $escaper->escapeUrl($block->getUrl(
            '*/*/resetpasswordpost',
            ['_query' => ['id' => $block->getRpCustomerId(), 'token' => $block->getResetPasswordLinkToken()]]
        )) ?>"
              x-data="initResetPasswordForm"
              @submit="onSubmit"
              method="post"
              id="form-validate"
              class="form password reset">
            <fieldset class="fieldset">
                <?= $block->getBlockHtml('formkey') ?>
                <p class="mb-6"><?= $escaper->escapeHtml(
                    __('Choose a secure new password for your account.')
                ) ?></p>
                <div class="field field-reserved required">
                    <label class="label" for="password">
                        <span><?= $escaper->escapeHtml(__('New Password')) ?></span>
                    </label>
                    <div class="control flex items-center">
                        <input :type="showPassword ? 'text' : 'password'"
                               type="password"
                               class="form-input w-full"
                               name="password"
                               id="password"
                               required
                               minlength="<?= $escaper->escapeHtmlAttr($minimumPasswordLength) ?>"
                               @input="onChange"
                               data-validate='{"password-strength": {"minCharacterSets": <?= (int) $passwordMinCharacterSets ?>}}'
                               autocomplete="<?= $block->isAutocompleteDisabled() ? 'off' : 'new-password' ?>">
                        <button type="button"
                                x-on:click="showPassword = !showPassword"
                                class="password-visibility-toggle"
                                :aria-pressed="showPassword ? 'true' : 'false'"
                                :aria-label="showPassword ? '<?= $escaper->escapeJs(__('Hide Password')) ?>' : '<?= $escaper->escapeJs(__('Show Password')) ?>'">
                            <template x-if="!showPassword">
                                <?= $heroicons->eyeHtml('', 20, 20, ['aria-hidden' => 'true']) ?>
                            </template>
                            <template x-if="showPassword">
                                <?= $heroicons->eyeOffHtml('', 20, 20, ['aria-hidden' => 'true']) ?>
                            </template>
                        </button>
                    </div>
                </div>
                <div class="field field-reserved required">
                    <label class="label" for="password-confirmation">
                        <span><?= $escaper->escapeHtml(__('Confirm New Password')) ?></span>
                    </label>
                    <div class="control flex items-center">
                        <input :type="showPasswordConfirm ? 'text' : 'password'"
                               type="password"
                               class="form-input w-full"
                               name="password_confirmation"
                               id="password-confirmation"
                               required
                               data-validate='{"equalTo": "password"}'
                               @input="onChange"
                               autocomplete="<?= $block->isAutocompleteDisabled() ? 'off' : 'new-password' ?>">
                        <button type="button"
                                x-on:click="showPasswordConfirm = !showPasswordConfirm"
                                class="password-visibility-toggle"
                                :aria-pressed="showPasswordConfirm ? 'true' : 'false'"
                                :aria-label="showPasswordConfirm ? '<?= $escaper->escapeJs(__('Hide Password')) ?>' : '<?= $escaper->escapeJs(__('Show Password')) ?>'">
                            <template x-if="!showPasswordConfirm">
                                <?= $heroicons->eyeHtml('', 20, 20, ['aria-hidden' => 'true']) ?>
                            </template>
                            <template x-if="showPasswordConfirm">
                                <?= $heroicons->eyeOffHtml('', 20, 20, ['aria-hidden' => 'true']) ?>
                            </template>
                        </button>
                    </div>
                </div>
            </fieldset>
            <div class="actions-toolbar">
                <button type="submit"
                        class="btn btn-primary"
                        :disabled="isSubmitting"
                        x-text="updateSubmitBtnText">
                    <?= $escaper->escapeHtml(__('Save New Password')) ?>
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    function initResetPasswordForm() {
        return Object.assign(
            hyva.formValidation(this.$el),
            {
                showPassword: false,
                showPasswordConfirm: false,
                updateSubmitBtnText() {
                    return this.isSubmitting
                        ? '<?= $escaper->escapeJs(__('Saving...')) ?>'
                        : '<?= $escaper->escapeJs(__('Save New Password')) ?>'
                }
            }
        );
    }

    window.addEventListener('alpine:init', () => {
        Alpine.data('initResetPasswordForm', initResetPasswordForm)
    }, { once: true })
</script>
<?php $hyvaCsp->registerInlineScript() ?>

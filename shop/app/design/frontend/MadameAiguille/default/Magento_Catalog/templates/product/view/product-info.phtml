<?php
/**
 * Madame Aiguille — colonne d'achat de la fiche produit
 *
 * Nom, accroche (description courte), prix et mention, encart de rareté ou
 * de série, sélecteur de taille (formulaire natif), quantité + ajout au
 * panier, encart « Une question sur le tissu ou le motif ? », rassurance
 * (bloc CMS). Fiche épuisée : bouton inactif « Série terminée » et encart de
 * mise en relation. Barre d'achat collante sur mobile une fois la galerie
 * défilée. Toute règle vient du ViewModel LimitedSeries.
 */

declare(strict_types=1);

use Hyva\Theme\Model\ViewModelRegistry;
use Hyva\Theme\ViewModel\ProductPage;
use MadameAiguille\Theme\ViewModel\Product\LimitedSeries;
use Magento\Catalog\Model\Product;
use Magento\ConfigurableProduct\Model\Product\Type\Configurable;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;

/** @var Template $block */
/** @var Escaper $escaper */
/** @var ViewModelRegistry $viewModels */

/** @var ProductPage $productViewModel */
$productViewModel = $viewModels->require(ProductPage::class);
/** @var LimitedSeries $limitedSeries */
$limitedSeries = $block->getData('limited_series') ?? $viewModels->require(LimitedSeries::class);

/** @var Product $product */
$product = $productViewModel->getProduct();
$isConfigurable = $product->getTypeId() === Configurable::TYPE_CODE;
$isSoldOut = $limitedSeries->isSoldOut($product);
$isLimited = $limitedSeries->isLimitedSeries($product);
$isScarce = $limitedSeries->isScarce($product);
$remaining = $limitedSeries->getRemainingQty($product);
$seriesSize = $limitedSeries->getSeriesSize($product);
$priceNote = $limitedSeries->getPriceNote();
$contactUrl = $limitedSeries->getContactUrl($product);
$shortDescription = $productViewModel->getShortDescription();

$infoIcon = '<svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true" class="mt-0.5 shrink-0">'
    . '<circle cx="10" cy="10" r="9" stroke="currentColor" stroke-width="1.5"/>'
    . '<path d="M10 9v5.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>'
    . '<circle cx="10" cy="5.9" r="1.1" fill="currentColor"/></svg>';
?>
<div class="product-info-main flex flex-col">
    <h1 class="mb-2 font-body font-medium text-title text-brand-ink md:mb-2.5 md:text-title-lg" itemprop="name">
        <?= $escaper->escapeHtml($product->getName()) ?>
    </h1>

    <?php if ($shortDescription): ?>
        <div class="product-short-description mb-4 italic text-base text-brand-ink md:mb-5 md:text-lead"><?= /* @noEscape */ $shortDescription ?></div>
    <?php endif; ?>

    <div class="pdp-price <?= $isSoldOut ? 'is-soldout' : '' ?>" role="group" aria-label="<?= $escaper->escapeHtmlAttr(__('Prix')) ?>">
        <?= $block->getChildHtml('product.info.price') ?>
    </div>
    <?php if ($priceNote !== ''): ?>
        <p class="mt-1 text-caption text-brand-muted"><?= $escaper->escapeHtml($priceNote) ?></p>
    <?php endif; ?>

    <?php if ($isSoldOut): ?>
        <?php if ($seriesSize !== null): ?>
            <p class="mt-2 text-caption text-brand-muted"><?= $escaper->escapeHtml(__('Série de %1, écoulée.', $seriesSize)) ?></p>
        <?php endif; ?>

        <span class="btn btn-size-lg mt-6 w-full" aria-disabled="true"><?= $escaper->escapeHtml($limitedSeries->getSoldOutLabel($product)) ?></span>

        <aside class="relative mt-7 overflow-hidden rounded-md border border-brand-nude bg-brand-blush p-6 md:p-7" aria-labelledby="pdp-contact-title">
            <h2 id="pdp-contact-title" class="mb-2.5 font-display text-display text-brand"><?= $escaper->escapeHtml(__('Ce modèle vous plaît ?')) ?></h2>
            <p class="on-blush mb-5 max-w-lg text-base text-pretty"><?= $escaper->escapeHtml(__('Il m’arrive de retrouver un coupon similaire. Dites-moi ce que vous cherchiez : je vous répondrai franchement si c’est possible ou non.')) ?></p>
            <a href="<?= $escaper->escapeUrl($contactUrl) ?>" class="btn btn-primary w-full sm:w-auto"><?= $escaper->escapeHtml(__('M’écrire à ce sujet')) ?></a>
        </aside>
    <?php else: ?>
        <?php if ($isScarce): ?>
            <div class="mt-6 flex gap-3 rounded-r-sm border border-l-3 border-error-border border-l-error bg-error-bg px-4 py-3.5 text-error" role="status">
                <?= /* @noEscape */ $infoIcon ?>
                <div>
                    <p class="font-medium text-base text-error-dark"><?= $escaper->escapeHtml($limitedSeries->getScarcityLabel($product)) ?></p>
                    <?php if ($seriesSize !== null): ?>
                        <p class="text-label leading-relaxed"><?= $escaper->escapeHtml(__('Sur les %1 de la série. Quand elle est écoulée, le modèle ne revient pas.', $seriesSize)) ?></p>
                    <?php endif; ?>
                </div>
            </div>
        <?php elseif ($isLimited && $remaining !== null && $seriesSize !== null): ?>
            <div class="mt-6 flex gap-3 rounded-r-sm border border-l-3 border-info-border border-l-info bg-info-bg px-4 py-3 text-info-dark">
                <?= /* @noEscape */ $infoIcon ?>
                <p class="text-label leading-relaxed"><?= $escaper->escapeHtml($remaining === 1
                    ? __('Dernier exemplaire disponible sur les %1 de la série.', $seriesSize)
                    : __('%1 exemplaires disponibles sur les %2 de la série.', $remaining, $seriesSize)) ?></p>
            </div>
        <?php elseif ($isLimited): ?>
            <p class="mt-5 text-label text-brand-muted"><?= $escaper->escapeHtml($limitedSeries->getSeriesLabel($product)) ?></p>
        <?php endif; ?>

        <div class="mt-6">
            <?= $block->getChildHtml('product.info.form') ?>
        </div>

        <div class="product-purchase flex flex-wrap items-end gap-4">
            <?= $block->getChildHtml('product.info.quantity') ?>
            <div class="min-w-48 flex-1">
                <?= $block->getChildHtml('product.info.addtocart') ?>
            </div>
        </div>

        <aside class="relative mt-8 overflow-hidden rounded-md border border-brand-nude bg-brand-blush p-6 md:p-7" aria-labelledby="pdp-contact-title">
            <svg width="132" height="42" viewBox="0 0 132 42" fill="none" aria-hidden="true" class="absolute -right-2.5 -bottom-1.5 text-brand-nude opacity-50">
                <path d="M4 36C32 36 66 27 128 8" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
                <g fill="currentColor"><ellipse cx="26" cy="30" rx="7.5" ry="3.2" transform="rotate(-18 26 30)"/><ellipse cx="48" cy="26" rx="7.5" ry="3.2" transform="rotate(-22 48 26)"/><ellipse cx="70" cy="21" rx="7.5" ry="3.2" transform="rotate(-26 70 21)"/><ellipse cx="92" cy="16" rx="7.5" ry="3.2" transform="rotate(-30 92 16)"/></g>
            </svg>
            <div class="relative">
                <h2 id="pdp-contact-title" class="mb-2.5 font-display text-display text-brand"><?= $escaper->escapeHtml(__('Une question sur le tissu ou le motif ?')) ?></h2>
                <p class="on-blush mb-5 max-w-lg text-base text-pretty"><?= $escaper->escapeHtml(__('Je réponds moi-même, en général sous 24 heures. Si vous cherchez un coloris plus sobre ou un motif précis, dites-le-moi : il me reste parfois des coupons de la série.')) ?></p>
                <a href="<?= $escaper->escapeUrl($contactUrl) ?>" class="btn w-full sm:w-auto"><?= $escaper->escapeHtml(__('Poser une question sur ce modèle')) ?></a>
            </div>
        </aside>
    <?php endif; ?>

    <?php if ($reassurance = $block->getChildHtml('reassurance')): ?>
        <div class="product-reassurance mt-7"><?= /* @noEscape */ $reassurance ?></div>
    <?php endif; ?>

    <?= $block->getChildHtml('product.info.additional') ?>
    <?= $block->getChildHtml('alert.urls') ?>

    <?php if (!$isSoldOut): ?>
        <?php /* Barre d'achat collante (mobile) : apparaît quand la galerie est sortie de l'écran */ ?>
        <div
            x-data="{ shown: false }"
            x-init="const gallery = document.getElementById('gallery'); if (gallery) { new IntersectionObserver(([entry]) => { shown = !entry.isIntersecting && entry.boundingClientRect.bottom < 0; }).observe(gallery); }"
            x-show="shown"
            x-cloak
            x-transition.opacity
            class="sticky-buy fixed inset-x-0 bottom-0 z-20 flex items-center gap-3 border-t border-brand-nude bg-surface px-5 py-3 shadow-raised md:hidden"
        >
            <div class="pdp-price pdp-price-compact shrink-0">
                <?= $block->getChildHtml('product.info.price') ?>
                <?php if ($remaining !== null): ?>
                    <p class="text-caption text-brand-muted"><?= $escaper->escapeHtml($remaining === 1 ? __('1 disponible') : __('%1 disponibles', $remaining)) ?></p>
                <?php endif; ?>
            </div>
            <button
                type="submit"
                form="product_addtocart_form"
                class="btn btn-primary flex-1"
                x-data="{ ready: <?= $isConfigurable ? 'false' : 'true' ?> }"
                @configurable-selection-changed.window="ready = !!$event.detail.productIndex"
                :disabled="!ready"
                data-addto="cart"
            ><?= $escaper->escapeHtml(__('Ajouter au panier')) ?></button>
        </div>
    <?php endif; ?>
</div>

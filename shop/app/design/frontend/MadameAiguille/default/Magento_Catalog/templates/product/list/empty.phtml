<?php
/**
 * Madame Aiguille — état vide d'une liste de produits (Design System §6.10)
 *
 * Trois règles : nommer ce qui manque, expliquer pourquoi, offrir une sortie.
 * Deux modes, choisis en layout XML par l'argument « mode » :
 *   - category : « La série est en cours de couture » + retour boutique
 *   - search    : « Aucune création trouvée » + rappel du terme + pastilles
 *                 vers les catégories de premier niveau + retour boutique
 * Le champ « me prévenir » de la maquette attend la décision newsletter (lot 3).
 */

declare(strict_types=1);

use Hyva\Theme\Model\ViewModelRegistry;
use Hyva\Theme\ViewModel\Navigation;
use Hyva\Theme\ViewModel\Search;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;

/** @var Template $block */
/** @var Escaper $escaper */
/** @var ViewModelRegistry $viewModels */

$mode = $block->getData('mode') === 'search' ? 'search' : 'category';
$shopUrl = $block->getUrl('');

if ($mode === 'search') {
    /** @var Navigation $navigation */
    $navigation = $viewModels->require(Navigation::class, $block);
    $categories = $navigation->getNavigation(2);
    $query = $viewModels->require(Search::class)->getEscapedQueryText();
    $title = __('Aucune création trouvée');
    $text = $query !== ''
        ? __('Rien ne correspond à « %1 ». Le catalogue ne compte que quelques dizaines de références : le plus simple est de tout parcourir.', $query)
        : __('Le catalogue ne compte que quelques dizaines de références : le plus simple est de tout parcourir.');
    $buttonLabel = __('Voir toute la boutique');
    $icon = '<circle cx="9.5" cy="9.5" r="6.5"/><path d="M14.5 14.5 19 19"/>';
    $viewBox = '0 0 22 22';
} else {
    $categories = [];
    $title = __('La série est en cours de couture');
    $text = __('Aucune création disponible pour le moment dans cette catégorie. Les séries sont courtes et se renouvellent au fil des coupons : repassez bientôt, ou parcourez le reste de la boutique.');
    $buttonLabel = __('Voir toute la boutique');
    $icon = '<path d="M10 14h20l-1.6 18H11.6L10 14Z"/><path d="M15.5 14v-2.5a4.5 4.5 0 0 1 9 0V14"/><path d="M15 22.5h10" stroke-dasharray="2.5 3.5"/>';
    $viewBox = '0 0 40 40';
}
?>
<div class="empty-state mx-auto my-6 max-w-2xl rounded-md border border-brand-line bg-surface px-5 py-10 text-center md:my-10 md:px-10 md:py-12" role="status">
    <svg width="52" height="52" viewBox="<?= $escaper->escapeHtmlAttr($viewBox) ?>" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" aria-hidden="true" class="mx-auto mb-5 text-brand-nude"><?= /* @noEscape */ $icon ?></svg>
    <h2 class="mb-2.5 font-display text-display text-brand md:text-display-lg"><?= $escaper->escapeHtml($title) ?></h2>
    <p class="mx-auto mb-6 max-w-md text-base text-brand-ink text-pretty"><?= $escaper->escapeHtml($text) ?></p>

    <?php if ($categories): ?>
        <ul class="mb-6 flex flex-wrap justify-center gap-2.5" aria-label="<?= $escaper->escapeHtmlAttr(__('Parcourir par catégorie')) ?>">
            <?php foreach ($categories as $category): ?>
                <li>
                    <a href="<?= $escaper->escapeUrl((string) $category['url']) ?>"
                       class="inline-flex min-h-11 items-center rounded-full border border-brand-nude bg-surface px-4 text-label text-brand no-underline transition-colors hover:border-brand hover:bg-brand-blush hover:text-brand-dark"
                    ><?= $escaper->escapeHtml((string) $category['name']) ?></a>
                </li>
            <?php endforeach; ?>
        </ul>
    <?php endif; ?>

    <a href="<?= $escaper->escapeUrl($shopUrl) ?>" class="btn <?= $mode === 'search' ? 'btn-primary' : '' ?>"><?= $escaper->escapeHtml($buttonLabel) ?></a>
</div>

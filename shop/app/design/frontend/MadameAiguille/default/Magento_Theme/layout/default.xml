<?xml version="1.0"?>
<!--
/**
 * Madame Aiguille — layout commun : header (logo centré, bandeau) et footer.
 * Fusionné avec le default.xml du parent Hyvä ; on ne redéclare que ce qui change.
 */
-->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <!-- Header -->
        <referenceBlock name="header-content">
            <arguments>
                <argument name="show_compare" xsi:type="boolean">false</argument>
            </arguments>
            <block class="Magento\Cms\Block\Block" name="header.announcement" as="announcement" before="-">
                <arguments>
                    <argument name="block_id" xsi:type="string">header_announcement</argument>
                </arguments>
            </block>
        </referenceBlock>

        <!-- Logo : verrou horizontal officiel, ratio intrinsèque conservé -->
        <referenceBlock name="logo">
            <arguments>
                <argument name="logo_file" xsi:type="string">images/logo-madame-aiguille.svg</argument>
                <argument name="logo_width" xsi:type="number">356</argument>
                <argument name="logo_height" xsi:type="number">66</argument>
            </arguments>
        </referenceBlock>

        <!-- Footer : quatre colonnes (marque, boutique, informations, paiement & livraison) -->
        <referenceBlock name="footer-static-links" remove="true"/>
        <referenceBlock name="footer-cms-content" remove="true"/>
        <referenceBlock name="footer-content">
            <block name="footer.brand" as="brand" template="Magento_Theme::html/footer/brand.phtml">
                <arguments>
                    <argument name="social_links" xsi:type="object">MadameAiguille\Theme\ViewModel\SocialLinks</argument>
                    <argument name="tagline" xsi:type="string" translate="true">L’élégance cousue main. Chaque pièce est cousue à la main, en série limitée.</argument>
                </arguments>
            </block>
            <block name="footer.shop" as="shop" template="Magento_Theme::html/footer/shop.phtml"/>
            <block name="footer.info" as="info" template="Magento_Theme::html/footer/links.phtml">
                <arguments>
                    <argument name="title" xsi:type="string" translate="true">Informations</argument>
                    <argument name="links" xsi:type="array">
                        <item name="about" xsi:type="array">
                            <item name="label" xsi:type="string" translate="true">À propos</item>
                            <item name="path" xsi:type="string">a-propos</item>
                        </item>
                        <item name="fabrics" xsi:type="array">
                            <item name="label" xsi:type="string" translate="true">Nos tissus</item>
                            <item name="path" xsi:type="string">nos-tissus</item>
                        </item>
                        <item name="contact" xsi:type="array">
                            <item name="label" xsi:type="string" translate="true">Contact</item>
                            <item name="path" xsi:type="string">contact</item>
                        </item>
                        <item name="shipping" xsi:type="array">
                            <item name="label" xsi:type="string" translate="true">Livraison &amp; retours</item>
                            <item name="path" xsi:type="string">livraison-retours</item>
                        </item>
                        <item name="terms" xsi:type="array">
                            <item name="label" xsi:type="string" translate="true">Conditions générales de vente</item>
                            <item name="path" xsi:type="string">cgv</item>
                        </item>
                        <item name="legal" xsi:type="array">
                            <item name="label" xsi:type="string" translate="true">Mentions légales</item>
                            <item name="path" xsi:type="string">mentions-legales</item>
                        </item>
                        <item name="privacy" xsi:type="array">
                            <item name="label" xsi:type="string" translate="true">Politique de confidentialité</item>
                            <item name="path" xsi:type="string">confidentialite</item>
                        </item>
                    </argument>
                </arguments>
            </block>
            <block name="footer.services" as="services" template="Magento_Theme::html/footer/services.phtml">
                <arguments>
                    <argument name="payment_methods" xsi:type="array">
                        <item name="cb" xsi:type="array">
                            <item name="label" xsi:type="string" translate="true">Carte bancaire CB</item>
                            <item name="image" xsi:type="string">images/footer/cb.webp</item>
                            <item name="width" xsi:type="number">28</item>
                            <item name="height" xsi:type="number">20</item>
                        </item>
                        <item name="visa" xsi:type="array">
                            <item name="label" xsi:type="string">Visa</item>
                            <item name="image" xsi:type="string">images/footer/visa.webp</item>
                            <item name="width" xsi:type="number">43</item>
                            <item name="height" xsi:type="number">14</item>
                        </item>
                        <item name="mastercard" xsi:type="array">
                            <item name="label" xsi:type="string">Mastercard</item>
                            <item name="image" xsi:type="string">images/footer/mastercard.webp</item>
                            <item name="width" xsi:type="number">26</item>
                            <item name="height" xsi:type="number">20</item>
                        </item>
                        <item name="apple_pay" xsi:type="array">
                            <item name="label" xsi:type="string">Apple Pay</item>
                            <item name="image" xsi:type="string">images/footer/apple-pay.webp</item>
                            <item name="width" xsi:type="number">49</item>
                            <item name="height" xsi:type="number">20</item>
                        </item>
                        <item name="google_pay" xsi:type="array">
                            <item name="label" xsi:type="string">Google Pay</item>
                            <item name="image" xsi:type="string">images/footer/google-pay.webp</item>
                            <item name="width" xsi:type="number">53</item>
                            <item name="height" xsi:type="number">20</item>
                        </item>
                        <item name="bancontact" xsi:type="array">
                            <item name="label" xsi:type="string">Bancontact</item>
                            <item name="image" xsi:type="string">images/footer/bancontact.webp</item>
                            <item name="width" xsi:type="number">32</item>
                            <item name="height" xsi:type="number">20</item>
                        </item>
                        <item name="klarna" xsi:type="array">
                            <item name="label" xsi:type="string">Klarna</item>
                            <item name="image" xsi:type="string">images/footer/klarna.webp</item>
                            <item name="width" xsi:type="number">48</item>
                            <item name="height" xsi:type="number">20</item>
                        </item>
                        <item name="on_site" xsi:type="array">
                            <item name="label" xsi:type="string" translate="true">Sur place au retrait</item>
                        </item>
                    </argument>
                    <argument name="shipping_methods" xsi:type="array">
                        <item name="mondialrelay" xsi:type="array">
                            <item name="label" xsi:type="string">Mondial Relay</item>
                            <item name="image" xsi:type="string">images/footer/mondial-relay.svg</item>
                            <item name="width" xsi:type="number">58</item>
                            <item name="height" xsi:type="number">20</item>
                        </item>
                        <item name="pickup" xsi:type="array">
                            <item name="label" xsi:type="string" translate="true">Retrait à l'atelier</item>
                            <item name="image" xsi:type="string">images/favicon.svg</item>
                            <item name="width" xsi:type="number">20</item>
                            <item name="height" xsi:type="number">20</item>
                            <item name="text" xsi:type="boolean">true</item>
                        </item>
                    </argument>
                </arguments>
            </block>
        </referenceBlock>
    </body>
</page>

<?php
/**
 * Madame Aiguille — colonne « Paiement & livraison » : logos officiels des moyens de paiement et des modes de
 * livraison (décision de Pierre du 02/11/2026, à la place des libellés en mots du Design System §6.11).
 *
 * Chaque entrée de layout : label (texte alternatif, ou texte seul sans image), image (chemin du thème),
 * width / height (taille affichée en px, l'image fait le double).
 */

declare(strict_types=1);

use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;

/** @var Template $block */
/** @var Escaper $escaper */

$groups = [
    [__('Paiement'), (array) $block->getData('payment_methods')],
    [__('Livraison'), (array) $block->getData('shipping_methods')],
];
?>
<div class="border-t border-brand-nude md:border-t-0 pt-4 md:pt-0">
    <?php foreach ($groups as [$title, $methods]): ?>
        <?php if (!$methods) { continue; } ?>
        <h2 class="mb-3 font-body font-medium text-caption uppercase tracking-label text-brand-dark"><?= $escaper->escapeHtml($title) ?></h2>
        <ul class="flex flex-wrap gap-2 mb-6" aria-label="<?= $escaper->escapeHtmlAttr($title) ?>">
            <?php foreach ($methods as $method): ?>
                <?php $label = (string) ($method['label'] ?? '') ?>
                <li class="inline-flex items-center gap-1.5 h-9 px-2.5 rounded-xs bg-white border border-brand-nude font-body text-caption text-brand-ink">
                    <?php if (!empty($method['image'])): ?>
                        <img
                            src="<?= $escaper->escapeUrl($block->getViewFileUrl($method['image'])) ?>"
                            alt="<?= $escaper->escapeHtmlAttr(!empty($method['text']) ? '' : $label) ?>"
                            width="<?= (int) $method['width'] ?>"
                            height="<?= (int) $method['height'] ?>"
                            class="block shrink-0"
                            loading="lazy"
                        >
                    <?php endif; ?>
                    <?php if (empty($method['image']) || !empty($method['text'])): ?>
                        <span><?= $escaper->escapeHtml($label) ?></span>
                    <?php endif; ?>
                </li>
            <?php endforeach; ?>
        </ul>
    <?php endforeach; ?>
</div>

<?php
/**
 * Madame Aiguille — mini-panier en tiroir latéral (Design System §6.9)
 *
 * 380 px sur desktop, plein écran sous 768 px. La barre de franco est le
 * premier élément lu : c'est elle qui fait grossir un panier de 15 €. Au-delà
 * de quatre articles la liste défile, le pied du tiroir restant fixe.
 *
 * Le comportement reste celui du parent Hyvä : `<dialog>` ouvert en modale, ce
 * qui donne gratuitement le piège de focus, la fermeture par Échap et le retour
 * du focus au bouton panier ; `closeby="any"` ferme au clic extérieur ; les
 * données viennent de la section privée `cart` et les erreurs remontent par
 * `minicart-error-message`.
 *
 * Deux ajouts : un sélecteur de quantité, plafonné au stock vendable transmis
 * par le plugin AddCartData, et la barre de franco calculée côté serveur. La
 * validation de la quantité reste celle de Magento (checkout/sidebar) : Alpine
 * ne fait que borner l'interface.
 *
 * Copié depuis vendor/hyva-themes/magento2-default-theme (Hyvä 1.5.2, OSL-3.0),
 * à resynchroniser lors d'une montée de version du thème parent.
 */

declare(strict_types=1);

use Hyva\Theme\Model\ViewModelRegistry;
use Hyva\Theme\ViewModel\HyvaCsp;
use Hyva\Theme\ViewModel\StoreConfig;
use Hyva\Theme\ViewModel\LucideIcons;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;

/** @var Escaper $escaper */
/** @var Template $block */
/** @var HyvaCsp $hyvaCsp */
/** @var ViewModelRegistry $viewModels */

$storeConfig = $viewModels->require(StoreConfig::class);
$maxItemsToDisplay = $storeConfig->getStoreConfig('checkout/sidebar/max_items_display_count');

/** @var LucideIcons $lucideIcons */
$lucideIcons = $viewModels->require(LucideIcons::class);

$miniCartOptionShowSku = $block->getShowSku() !== null ? (bool) $block->getShowSku() : false;
?>

<script>
    function initCartDrawer() {
        return {
            open: false,
            isLoading: false,
            cart: {},
            maxItemsToDisplay: <?= (int) $maxItemsToDisplay ?>,
            itemsCount: 0,
            showSku: <?= $miniCartOptionShowSku ? 'true' : 'false' ?>,
            autocompleteNumber: 100,
            init() {
                if (document.prerendering) {
                    document.addEventListener("prerenderingchange", () => {
                        window.dispatchEvent(
                            new CustomEvent('reload-customer-section-data')
                        );
                    }, { once: true });
                }
            },
            showDetails() {
                return this.item.options && this.item.options.length || this.showSku;
            },
            cartIsEmpty() {
                return this.itemsCount === 0
            },
            getData() {
                const data = this.$event.detail.data;

                if (data.cart) {
                    this.cart = data.cart;
                    this.itemsCount = data.cart.items && data.cart.items.length || 0;
                    this.setCartItems();
                }
                this.isLoading = false;
            },
            cartItems: [],
            getItemCountTitle() {
                return hyva.strf('<?= $escaper->escapeJs(__('%0 of %1 products in cart displayed')) ?>', this.maxItemsToDisplay, this.itemsCount)
            },
            shouldShowItemCount() {
                return this.maxItemsToDisplay && this.maxItemsToDisplay < this.itemsCount;
            },
            setCartItems() {
                this.cartItems = this.cart.items && this.cart.items.sort((a, b) => b.item_id - a.item_id) || [];

                if (this.maxItemsToDisplay > 0) {
                    this.cartItems = this.cartItems.slice(0, parseInt(this.maxItemsToDisplay, 10));
                }
            },
            updateItemQty(event) {
                const form = event.target;
                this.isLoading = true;
                hyvaAjaxFormMinicart({ form, redirect: false }, () => {
                    this.isLoading = false;
                });
            },
            deleteItemFromCart() {
                const itemId = this.item.item_id;
                const formKey = hyva.getFormKey();
                this.isLoading = true;

                hyvaAjaxFormMinicart({
                    url: BASE_URL + 'checkout/sidebar/removeItem/',
                    body: 'form_key=' + formKey + '&item_id=' + itemId,
                    message: '<?= $escaper->escapeJs(__('You removed the item.')) ?>'
                }, () => {
                    this.isLoading = false
                });
            },
            toggleCartDrawer(event) {
                this.open = event.detail?.isOpen ?? !this.open;
            },
            openCartDrawer() {
                this.open = true;
            },
            closeCartDrawer() {
                this.open = false;
            },
            getSectionDataExtraActions() {
                if (!this.cart.extra_actions) {
                    return '';
                }

                const contentNode = document.createElement('div');
                contentNode.innerHTML = this.cart.extra_actions;

                hyva.activateScripts(contentNode);

                return contentNode.innerHTML;
            },
            productIsVisibleInSite() {
                return this.item.product_has_url && this.item.is_visible_in_site_visibility
            },
            productIsNotVisibleInSite() {
                return !this.productIsVisibleInSite()
            },
            productIsNotGroupedAndVisibleInSite() {
                return this.item.product_type !== 'grouped' && this.item.is_visible_in_site_visibility
            },
            productAriaLabel() {
                return hyva.strf(this.$el.dataset.ariaLabel, this.item.product_name)
            },
            proceedToCheckout() {
                this.closeCartDrawer()

                this.$dispatch(
                    'toggle-authentication',
                    {
                        url: '<?= $escaper->escapeUrl($block->getUrl('checkout')) ?>'
                    }
                )
            },
            franco() {
                return this.cart.free_shipping || { enabled: false };
            },
            itemMax(item) {
                return item.max_qty === null || item.max_qty === undefined
                    ? null
                    : parseInt(item.max_qty, 10);
            },
            atItemMin(item) {
                return Math.round(item.qty) <= 1;
            },
            atItemMax(item) {
                const max = this.itemMax(item);
                return max !== null && Math.round(item.qty) >= max;
            },
            changeItemQty(item, delta) {
                const max = this.itemMax(item);
                let qty = Math.round(item.qty) + delta;
                qty = Math.max(1, qty);
                if (max !== null) qty = Math.min(max, qty);
                if (qty === Math.round(item.qty)) return;
                this.submitItemQty(item, qty);
            },
            /**
             * La validation reste celle de Magento (checkout/sidebar) : en cas de
             * refus, l'erreur native remonte par `minicart-error-message` et
             * s'affiche sur la ligne concernée.
             */
            submitItemQty(item, qty) {
                item.qty = qty;
                item.message = '';
                this.isLoading = true;

                hyvaAjaxFormMinicart({
                    url: BASE_URL + 'checkout/sidebar/updateItemQty/',
                    body: 'form_key=' + hyva.getFormKey() + '&item_id=' + item.item_id + '&item_qty=' + qty
                }, () => {
                    this.isLoading = false;
                });
            },
            setItemMessage(itemId, message) {
                const items = this.cartItems;
                items.forEach((item) => {
                    if (item.item_id === itemId) {
                        item.message = message;
                    }
                });
            },
            cartListeners: {
                ['@private-content-loaded.window'](event) {
                    this.getData(event.detail.data);
                },
                ['@toggle-cart.window'](event) {
                    this.toggleCartDrawer(event);
                },
                ['@minicart-error-message.window'](event) {
                    if (!event.detail) return;
                    const { itemId, message } = event.detail;
                    this.setItemMessage(itemId, message);
                },
                ["@pageshow.window"](event) {
                    if (event.persisted) {
                        this.open = false;
                        window.dispatchEvent(new CustomEvent("reload-customer-section-data"));
                    }
                }
            }
        }
    }

    window.addEventListener('alpine:init', () => {
        Alpine.data('initCartDrawer', initCartDrawer);
    }, { once: true })

    async function hyvaAjaxFormMinicart(
        {
            form = null,
            url = '',
            body = '',
            redirect = 'default',
            message = '',
        } = {},
        callback = () => {}
    ) {
        const formData = body ? body : (form ? new FormData(form) : '');
        const postUrl = url ? url : (form ? form.action : '');
        if (!formData || !postUrl) {
            console.warn('You must provide the form or formData and postUrl!');
            return;
        }

        const formUenc = hyva.getUenc();
        const itemId = body ? new URLSearchParams(body).get('item_id') : formData.get('item_id');
        let bodyUrl = new URLSearchParams(formData);
        bodyUrl.append('uenc', formUenc);

        try {
            const response = await fetch(postUrl, {
                method: 'POST',
                body: bodyUrl.toString(),
                mode: 'cors',
                credentials: 'include',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8',
                    'X-Requested-With': 'XMLHttpRequest'
                }
            });

            if (!response.ok) {
                return form.submit();
            }

            if (redirect === 'default' && response.redirected) {
                return window.location.href = response.url;
            } else if (redirect !== 'default' && redirect !== false) {
                return window.location.href = redirect;
            }

            const responseBody = await response.json();

            if (!responseBody.success) {
                throw responseBody.error_message;
            }

            window.dispatchEvent(new CustomEvent('reload-customer-section-data'));
        } catch (error) {
            window.dispatchEvent(new CustomEvent('minicart-error-message', { detail: { itemId, message: error } }));
        } finally {
            callback();
        }
    }
</script>
<?php $hyvaCsp->registerInlineScript() ?>

<dialog
    id="cart-drawer"
    aria-labelledby="cart-drawer-title"
    <?php /*
        Aucun attribut `x-transition` sur ce dialog : combiné à x-show et
        x-htmldialog, il fait passer l'ouverture par le chemin de transition
        différé d'Alpine, qui rappelle `_x_doShow` après coup — le tiroir met
        alors plusieurs secondes à s'ouvrir et se rouvre tout seul après une
        fermeture. Le glissement est animé en CSS (`page-cart.css`), où il
        respecte aussi `prefers-reduced-motion`.
    */ ?>
    class="cart-drawer"
    x-data="initCartDrawer"
    x-bind="cartListeners"
    x-show="open"
    x-htmldialog="closeCartDrawer"
    closeby="any"
>
    <?= $block->getChildHtml('cart-drawer.top'); ?>

    <header class="cart-drawer-header">
        <p id="cart-drawer-title" class="cart-drawer-title">
            <?= $escaper->escapeHtml(__('Mon panier')) ?>
            <?php /* summary_count : le même compte d'exemplaires que le badge du header et la page panier. */ ?>
            <span class="cart-drawer-count" x-show="itemsCount" x-cloak>(<span x-text="cart.summary_count"></span>)</span>
        </p>
        <button
            type="button"
            class="cart-drawer-close"
            @click="closeCartDrawer"
            aria-label="<?= $escaper->escapeHtmlAttr(__('Fermer le mini-panier')) ?>"
        >
            <?= $lucideIcons->xHtml('', 24, 24, ['aria-hidden' => 'true']); ?>
        </button>
    </header>

    <?php /* Franco : état calculé côté serveur, jamais depuis les prix affichés. */ ?>
    <template x-if="itemsCount && franco().enabled">
        <section
            class="franco-bar"
            :class="franco().reached && 'franco-bar-reached'"
            aria-label="<?= $escaper->escapeHtmlAttr(__('Progression vers la livraison offerte')) ?>"
        >
            <p class="franco-bar-message" x-text="franco().message"></p>
            <div class="franco-bar-track" role="progressbar"
                 aria-valuemin="0" aria-valuemax="100"
                 :aria-valuenow="franco().progress"
                 :aria-valuetext="franco().message">
                <span class="franco-bar-fill" :style="`width: ${franco().progress}%`"></span>
            </div>
            <p class="franco-bar-amounts" x-show="!franco().reached" x-text="franco().progress_label"></p>
        </section>
    </template>

    <?= $block->getChildHtml('cart-drawer.items.before'); ?>

    <template x-if="cartIsEmpty">
        <div class="cart-drawer-empty">
            <div>
                <?= $lucideIcons->shoppingBasketHtml('mx-auto text-brand-nude', 88, 88, ['aria-hidden' => 'true']); ?>
                <p class="cart-drawer-empty-title"><?= $escaper->escapeHtml(__('Votre panier est vide')) ?></p>
                <p class="cart-drawer-empty-copy"><?= $escaper->escapeHtml(__('Les séries tournent vite : il y a sans doute quelque chose de neuf depuis votre dernière visite.')) ?></p>
            </div>
        </div>
    </template>

    <?php /* Au-delà de quatre articles la liste défile ; le pied reste visible. */ ?>
    <template x-if="itemsCount">
        <ul class="cart-drawer-items">
            <template x-for="item in cartItems" :key="item.item_id">
                <li class="cart-drawer-item">
                    <template x-if="productIsVisibleInSite">
                        <a
                            class="cart-drawer-photo"
                            :href="item.product_url"
                            data-aria-label="<?= $escaper->escapeHtmlAttr(__('Création « %0 »')) ?>"
                            :title="item.product_name"
                            tabindex="-1"
                        >
                            <img :src="item.product_image.src" :width="item.product_image.width"
                                 :height="item.product_image.height" loading="lazy" :alt="item.product_name">
                        </a>
                    </template>
                    <template x-if="productIsNotVisibleInSite">
                        <div class="cart-drawer-photo">
                            <img :src="item.product_image.src" :width="item.product_image.width"
                                 :height="item.product_image.height" loading="lazy" :alt="item.product_name">
                        </div>
                    </template>

                    <div class="cart-drawer-details">
                        <div class="cart-drawer-line">
                            <p class="cart-drawer-name" x-text="item.product_name"></p>
                            <span class="cart-drawer-price" x-html="item.product_price"></span>
                        </div>

                        <template x-if="showDetails">
                            <dl class="cart-drawer-options">
                                <template x-if="showSku">
                                    <div>
                                        <dt><?= $escaper->escapeHtml(__('Réf.')) ?></dt>
                                        <dd x-text="item.product_sku"></dd>
                                    </div>
                                </template>
                                <template x-for="option in item.options">
                                    <div>
                                        <dt x-text="option.label"></dt>
                                        <dd x-html="option.value"></dd>
                                    </div>
                                </template>
                            </dl>
                        </template>

                        <div class="cart-drawer-actions">
                            <div class="qty-stepper qty-stepper-sm">
                                <button type="button" class="qty-step"
                                        @click="changeItemQty(item, -1)" :disabled="atItemMin(item)"
                                        data-aria-label="<?= $escaper->escapeHtmlAttr(__('Retirer un exemplaire de « %0 »')) ?>"
                                        :aria-label="productAriaLabel">−</button>
                                <span class="qty-value" x-text="item.qty"
                                      aria-live="polite"
                                      data-aria-label="<?= $escaper->escapeHtmlAttr(__('Quantité de « %0 »')) ?>"
                                      :aria-label="productAriaLabel"></span>
                                <button type="button" class="qty-step"
                                        @click="changeItemQty(item, 1)" :disabled="atItemMax(item)"
                                        data-aria-label="<?= $escaper->escapeHtmlAttr(__('Ajouter un exemplaire de « %0 »')) ?>"
                                        :aria-label="productAriaLabel">+</button>
                            </div>

                            <button
                                type="button"
                                class="cart-drawer-remove"
                                @click="deleteItemFromCart"
                                data-aria-label="<?= $escaper->escapeHtmlAttr(__('Retirer « %0 » du panier')) ?>"
                                :aria-label="productAriaLabel"
                            >
                                <?= $lucideIcons->trashHtml('', 20, 20, ['aria-hidden' => 'true']); ?>
                            </button>
                        </div>

                        <?php /* L'aide n'apparaît qu'au plafond : ailleurs, elle encombre un tiroir de 380 px. */ ?>
                        <p class="cart-drawer-hint" x-show="atItemMax(item) && item.qty_hint" x-text="item.qty_hint" x-cloak></p>

                        <template x-if="item.message">
                            <div class="message error cart-drawer-message" role="status" x-text="item.message"></div>
                        </template>
                    </div>
                </li>
            </template>
        </ul>
    </template>

    <?= $block->getChildHtml('cart-drawer.bottom'); ?>

    <template x-if="itemsCount">
        <footer class="cart-drawer-footer">
            <?= $block->getChildHtml('cart-drawer.totals.before'); ?>

            <p class="cart-drawer-count-note" x-show="shouldShowItemCount" x-text="getItemCountTitle" x-cloak></p>

            <dl class="cart-drawer-subtotal">
                <dt><?= $escaper->escapeHtml(__('Sous-total')) ?></dt>
                <dd x-html="cart.subtotal"></dd>
            </dl>
            <p class="cart-drawer-note"><?= $escaper->escapeHtml(__('Frais de port calculés à l’étape de livraison.')) ?></p>

            <div class="cart-drawer-buttons">
                <a
                    @click.prevent.stop="proceedToCheckout"
                    href="<?= $escaper->escapeUrl($block->getUrl('checkout')) ?>"
                    class="btn btn-primary btn-size-lg"
                ><?= $escaper->escapeHtml(__('Passer commande')) ?></a>
                <a
                    href="<?= $escaper->escapeUrl($block->getUrl('checkout/cart')) ?>"
                    class="btn btn-size-lg"
                ><?= $escaper->escapeHtml(__('Voir le panier')) ?></a>
                <div x-html="getSectionDataExtraActions()"></div>
                <?= $block->getChildHtml('extra_actions'); ?>
            </div>
        </footer>
    </template>

    <template x-if="cartIsEmpty">
        <footer class="cart-drawer-footer">
            <button type="button" @click="closeCartDrawer" class="btn btn-primary btn-size-lg w-full">
                <?= $escaper->escapeHtml(__('Continuer mes achats')) ?>
            </button>
        </footer>
    </template>

    <?= $block->getChildHtml('loading') ?>
</dialog>

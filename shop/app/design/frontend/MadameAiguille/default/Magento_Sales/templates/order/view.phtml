<?php
/**
 * Détail d'une commande et frise d'avancement.
 */

declare(strict_types=1);

use MadameAiguille\Theme\ViewModel\Order\Progress;
use Magento\Framework\Escaper;
use Magento\Sales\Block\Order\View;

/** @var View $block */
/** @var Escaper $escaper */
/** @var Progress $progress */
$progress = $block->getData('view_model');
$order = $block->getOrder();
?>
<article class="order-detail">
    <header class="order-detail-header">
        <div>
            <h1><?= $escaper->escapeHtml(__('Order #%1', $order->getRealOrderId())) ?></h1>
            <?= $block->getChildHtml('order.date') ?>
        </div>
        <span class="order-status order-status-<?= $escaper->escapeHtmlAttr($progress->getBadgeVariant($order)) ?>">
            <?= $escaper->escapeHtml($order->getStatusLabel()) ?>
        </span>
        <?php if (!$block->getData('is_context_shipment')): ?>
            <?= $block->getChildHtml('sales.order.buttons') ?>
        <?php else: ?>
            <?= $block->getChildHtml('sales.shipment.buttons') ?>
        <?php endif; ?>
    </header>

    <section class="order-timeline-panel" aria-labelledby="order-tracking-title">
        <h2 id="order-tracking-title"><?= $escaper->escapeHtml(__('Tracking')) ?></h2>
        <p class="order-progress-copy"><?= $escaper->escapeHtml($progress->getPhrase($order)) ?></p>
        <ol class="order-timeline">
            <?php foreach ($progress->getTimeline($order) as $step): ?>
                <li class="order-timeline-step is-<?= $escaper->escapeHtmlAttr($step['state']) ?>"
                    <?php if ($step['state'] === 'current'): ?>aria-current="step"<?php endif; ?>>
                    <span class="order-timeline-marker" aria-hidden="true"></span>
                    <strong><?= $escaper->escapeHtml($step['label']) ?></strong>
                    <span><?= $escaper->escapeHtml($step['date'] ?: __('Coming up')) ?></span>
                </li>
            <?php endforeach; ?>
        </ol>
    </section>

    <div class="order-detail-content">
        <?= $block->getChildHtml('order_top_items') ?>
        <div class="order-detail-information">
            <?= $block->getChildHtml('sales.order.info') ?>
        </div>
        <?= $block->getChildHtml('order.comments') ?>

        <?php if (!$block->getData('is_context_shipment')): ?>
            <div class="order-title">
                <h2><?= $escaper->escapeHtml(__('Items Ordered')) ?></h2>
                <?php if (!empty($order->getTracksCollection()->getItems())): ?>
                    <?= $block->getChildHtml('tracking-info-link') ?>
                <?php endif; ?>
            </div>
        <?php endif; ?>

        <?= $block->getChildHtml('order_items') ?>

        <?= $block->getChildHtml('madameaiguille_gift_card') ?>

        <a class="btn btn-link btn-size-sm" href="<?= $escaper->escapeUrl($block->getBackUrl()) ?>">
            <?= $escaper->escapeHtml($block->getBackTitle()) ?>
        </a>
    </div>
</article>

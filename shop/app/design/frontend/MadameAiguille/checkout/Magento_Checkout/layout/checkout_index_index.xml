<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <link rel="preload" src="fonts/Sentient-Regular.woff2" src_type="font/woff2"
              as="font" crossorigin="anonymous"/>
    </head>
    <body>
        <referenceBlock name="logo">
            <arguments>
                <argument name="logo_file" xsi:type="string">images/logo-rectangulaire.jpg</argument>
                <argument name="logo_alt" xsi:type="string" translate="true">Madame Aiguille — Accueil</argument>
                <argument name="logo_width" xsi:type="number">300</argument>
                <argument name="logo_height" xsi:type="number">96</argument>
            </arguments>
        </referenceBlock>
        <referenceContainer name="checkout.header.wrapper">
            <block class="Magento\Framework\View\Element\Template" name="madameaiguille.checkout.back"
                   template="Magento_Checkout::header/back.phtml" after="logo"/>
        </referenceContainer>
        <referenceBlock name="copyright" template="Magento_Checkout::footer.phtml"/>
        <referenceBlock name="checkout.root">
            <arguments>
                <argument name="jsLayout" xsi:type="array">
                    <item name="components" xsi:type="array">
                        <item name="checkout" xsi:type="array">
                            <item name="children" xsi:type="array">
                                <item name="steps" xsi:type="array">
                                    <item name="children" xsi:type="array">
                                        <item name="billing-step" xsi:type="array">
                                            <item name="children" xsi:type="array">
                                                <item name="payment" xsi:type="array">
                                                    <item name="children" xsi:type="array">
                                                        <item name="madameaiguille-newsletter" xsi:type="array">
                                                            <item name="component" xsi:type="string">js/view/newsletter</item>
                                                            <item name="displayArea" xsi:type="string">beforeMethods</item>
                                                            <item name="sortOrder" xsi:type="number">5</item>
                                                        </item>
                                                    </item>
                                                </item>
                                            </item>
                                        </item>
                                    </item>
                                </item>
                                <item name="sidebar" xsi:type="array">
                                    <item name="children" xsi:type="array">
                                        <item name="summary" xsi:type="array">
                                            <item name="children" xsi:type="array">
                                                <item name="cart_items" xsi:type="array">
                                                    <item name="sortOrder" xsi:type="number">10</item>
                                                </item>
                                                <item name="totals" xsi:type="array">
                                                    <item name="sortOrder" xsi:type="number">20</item>
                                                    <item name="children" xsi:type="array">
                                                        <item name="shipping" xsi:type="array">
                                                            <item name="config" xsi:type="array">
                                                                <item name="notCalculatedMessage" xsi:type="string"
                                                                      translate="true">Calculated after choosing delivery</item>
                                                            </item>
                                                        </item>
                                                    </item>
                                                </item>
                                            </item>
                                        </item>
                                    </item>
                                </item>
                            </item>
                        </item>
                    </item>
                </argument>
            </arguments>
        </referenceBlock>
    </body>
</page>
